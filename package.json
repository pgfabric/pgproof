{
  "name": "pgproof",
  "version": "0.1.0",
  "description": "Postgres backups that prove they restore \u2014 dump, restore into a disposable cluster, verify.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "pgproof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node --import tsx test/e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pgfabric/pgproof"
  },
  "homepage": "https://pgproof.com",
  "keywords": [
    "postgres",
    "postgresql",
    "backup",
    "restore",
    "pg_dump",
    "verification",
